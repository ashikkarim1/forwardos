'use client'

import { useState, useMemo } from 'react'
import { motion } from 'framer-motion'
import {
  TrendingUp,
  BarChart3,
  Target,
  AlertCircle,
  CheckCircle2,
  FileText,
  MessageSquare,
  Eye,
  Clock,
  DollarSign,
  Brain,
  ArrowRight,
  ArrowUpRight,
  Download,
  Calendar,
  TrendingUpIcon,
  Flame,
} from 'lucide-react'
import { DashboardHeader } from '@/components/DashboardHeader'
import { COLOR_PRIMARY, COLOR_ACCENT, COLOR_TEXT_SECONDARY, COLOR_BORDER } from '@/styles/forward-colors'

const dealsData: Record<string, any> = {
  '1': {
    id: '1',
    name: 'Acme Manufacturing Corp',
    industry: 'Manufacturing',
    stage: 'Growth',
    location: 'New York, USA',
    revenue: 125,
    ebitda: 28,
    heat: 87,
    avgDaysToClose: 45,
    status: 'active',
    description: 'Leading manufacturer of industrial components with strong market position and 3-year revenue CAGR of 12%.',
    founded: 2010,
    employees: 450,
    website: 'www.acmemanufacturing.com',
    revenueGrowth: 12.5,
    ebitdaMargin: 22.4,
    grossMargin: 42.1,
    priceToEbitda: 8.2,
    priceToRevenue: 1.84,
    priceToSales: 1.84,
    debtToEbitda: 2.1,
    currentValuation: 1050,
    valuation: {
      dcf: { min: 950, mid: 1150, max: 1350 },
      comparables: { min: 980, mid: 1100, max: 1200 },
      precedent: { min: 920, mid: 1000, max: 1150 },
    },
    comparables: [
      { name: 'Industrial Parts Inc', revenue: 118, ebitda: 26.5, ev: 1020, evEbitda: 8.1, location: 'Ohio' },
      { name: 'Precision Manufacturing', revenue: 142, ebitda: 31.2, ev: 1180, evEbitda: 8.5, location: 'Michigan' },
      { name: 'Components Direct', revenue: 98, ebitda: 21.3, ev: 850, evEbitda: 7.9, location: 'Indiana' },
    ],
    lastDeal: {
      name: 'Premier Industrial Parts (Closed 6 months ago)',
      revenue: 128,
      ebitda: 28.8,
      purchasePrice: 1050,
      evEbitda: 7.9,
      growth: 13.2,
      margin: 22.5,
      differences: 'Similar size and margin profile. Premier had slightly higher growth (13.2% vs 12.5%), traded at 7.9x EBITDA vs market 8.2x. Lower growth justified discount. Acme has more stable revenue base.',
    },
    marketShare: 2.8,
    marketSize: 4500,
    marketGrowth: 4.2,
    competitorCount: 8,
    risks: [
      { category: 'Market', severity: 'medium', description: 'Cyclical manufacturing industry sensitive to economic downturns', impact: 'Moderate' },
      { category: 'Customer', severity: 'low', description: 'Top 3 customers represent 35% of revenue', impact: 'Low' },
      { category: 'Supply Chain', severity: 'medium', description: 'Key supplier concentration in Asia with geopolitical risks', impact: 'Medium' },
      { category: 'Technology', severity: 'low', description: 'Moderate capex requirements for equipment upgrades', impact: 'Low' },
    ],
    forecast: {
      years: ['2024', '2025', '2026', '2027', '2028'],
      revenue: [125, 140.6, 158.2, 178.0, 200.1],
      ebitda: [28, 32.2, 37.5, 43.6, 50.8],
    },
    momentum: [
      { date: '2024-01-15', event: 'Deal Listed', status: 'public' },
      { date: '2024-02-01', event: '12 LOIs Received', status: 'active' },
      { date: '2024-02-20', event: 'Top 3 Buyers Proceed to DD', status: 'active' },
      { date: '2024-03-10', event: 'Data Room Opened', status: 'current' },
    ],
    kpis: [
      { label: 'Revenue', value: '$125M', trend: '+12.5%', color: '#10B981' },
      { label: 'EBITDA', value: '$28M', trend: '+14.3%', color: '#3B82F6' },
      { label: 'Heat Score', value: '87/100', trend: '+8', color: '#FF8C00' },
      { label: 'Deal Days', value: '45 avg', trend: '-12%', color: '#8B5CF6' },
    ],
  },
}

const containerVariants = {
  hidden: { opacity: 0 },
  visible: { opacity: 1, transition: { staggerChildren: 0.05 } },
}

const itemVariants = {
  hidden: { opacity: 0, y: 20 },
  visible: { opacity: 1, y: 0 },
}

export default function DealDetailPage({ params }: { params: { id: string } }) {
  const deal = dealsData[params.id] || dealsData['1']
  const [activeTab, setActiveTab] = useState('overview')
  const [expandedRisk, setExpandedRisk] = useState<string | null>(null)

  const weightedValuation = useMemo(() => {
    const dcf = deal.valuation.dcf.mid
    const comp = deal.valuation.comparables.mid
    const prec = deal.valuation.precedent.mid
    return Math.round((dcf * 0.5 + comp * 0.35 + prec * 0.15) * 100) / 100
  }, [deal])

  const valuationMin = Math.min(deal.valuation.dcf.min, deal.valuation.comparables.min, deal.valuation.precedent.min)
  const valuationMax = Math.max(deal.valuation.dcf.max, deal.valuation.comparables.max, deal.valuation.precedent.max)

  const tabs = [
    { id: 'overview', label: 'Overview', icon: Eye },
    { id: 'financials', label: 'Financials & Valuation', icon: DollarSign },
    { id: 'comparables', label: 'Comparables', icon: BarChart3 },
    { id: 'market', label: 'Market Analysis', icon: TrendingUp },
    { id: 'risks', label: 'Risk Dashboard', icon: AlertCircle },
    { id: 'diligence', label: 'Diligence', icon: CheckCircle2 },
    { id: 'dataroom', label: 'Data Room', icon: FileText },
  ]

  return (
    <>
      <DashboardHeader
        breadcrumbs={[
          { label: 'Forward OS', href: '/' },
          { label: 'Deal Discovery', href: '/deals' },
          { label: deal.name },
        ]}
        onMenuToggle={() => window.dispatchEvent(new CustomEvent('toggleSidebar'))}
        sidebarOpen={true}
        title={deal.name}
        subtitle={`${deal.industry} • ${deal.location} • ${deal.status.toUpperCase()}`}
        userProfile={{
          name: 'Investor',
          email: 'investor@forward.ae',
          role: 'Buyer',
        }}
      />

      <motion.div
        className="max-w-7xl mx-auto px-6 py-8 space-y-8"
        initial="hidden"
        animate="visible"
        variants={containerVariants}
      >
        {/* KPI Cards */}
        <motion.div
          variants={itemVariants}
          className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4"
        >
          {deal.kpis.map((kpi: any, idx: number) => (
            <motion.div
              key={idx}
              className="p-6 rounded-lg border hover:shadow-md transition-all"
              style={{ borderColor: COLOR_BORDER, background: 'white' }}
              whileHover={{ y: -2 }}
            >
              <p className="text-sm font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                {kpi.label}
              </p>
              <p className="text-3xl font-black mb-2" style={{ color: kpi.color }}>
                {kpi.value}
              </p>
              <p className="text-xs font-bold" style={{ color: kpi.color }}>
                {kpi.trend} YoY
              </p>
            </motion.div>
          ))}
        </motion.div>

        {/* Tab Navigation */}
        <motion.div variants={itemVariants} className="border-b" style={{ borderColor: COLOR_BORDER }}>
          <div className="flex gap-1 overflow-x-auto">
            {tabs.map(tab => {
              const Icon = tab.icon
              const isActive = activeTab === tab.id
              return (
                <motion.button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className="px-6 py-3 border-b-2 font-semibold text-sm transition-all whitespace-nowrap flex items-center gap-2"
                  style={{
                    borderColor: isActive ? COLOR_ACCENT : 'transparent',
                    color: isActive ? COLOR_ACCENT : COLOR_TEXT_SECONDARY,
                  }}
                  whileHover={{ color: COLOR_ACCENT }}
                >
                  <Icon className="w-4 h-4" />
                  {tab.label}
                </motion.button>
              )
            })}
          </div>
        </motion.div>

        {/* TAB CONTENT - OVERVIEW */}
        {activeTab === 'overview' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            {/* Investment Thesis */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <div className="flex items-center gap-3 mb-6">
                <Brain className="w-6 h-6" style={{ color: COLOR_ACCENT }} />
                <h2 className="text-2xl font-black" style={{ color: COLOR_PRIMARY }}>
                  Investment Thesis
                </h2>
              </div>
              <p className="text-lg mb-4" style={{ color: COLOR_TEXT_SECONDARY }}>
                {deal.description}
              </p>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div className="p-4 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                  <p className="text-xs font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                    Founded
                  </p>
                  <p className="text-xl font-black" style={{ color: COLOR_PRIMARY }}>
                    {deal.founded}
                  </p>
                </div>
                <div className="p-4 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                  <p className="text-xs font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                    Employees
                  </p>
                  <p className="text-xl font-black" style={{ color: COLOR_PRIMARY }}>
                    {deal.employees}
                  </p>
                </div>
                <div className="p-4 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                  <p className="text-xs font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                    Market Share
                  </p>
                  <p className="text-xl font-black" style={{ color: COLOR_PRIMARY }}>
                    {deal.marketShare}%
                  </p>
                </div>
                <div className="p-4 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                  <p className="text-xs font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                    Competitors
                  </p>
                  <p className="text-xl font-black" style={{ color: COLOR_PRIMARY }}>
                    {deal.competitorCount}
                  </p>
                </div>
              </div>
            </motion.section>

            {/* Deal Momentum Timeline */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <div className="flex items-center gap-3 mb-6">
                <Clock className="w-6 h-6" style={{ color: COLOR_ACCENT }} />
                <h2 className="text-2xl font-black" style={{ color: COLOR_PRIMARY }}>
                  Deal Momentum Timeline
                </h2>
              </div>
              <div className="space-y-4">
                {deal.momentum.map((event: any, idx: number) => (
                  <div key={idx} className="flex gap-4">
                    <div className="flex flex-col items-center">
                      <div
                        className="w-4 h-4 rounded-full border-2"
                        style={{
                          borderColor: event.status === 'current' ? COLOR_ACCENT : COLOR_BORDER,
                          background: event.status === 'current' ? COLOR_ACCENT : 'white',
                        }}
                      />
                      {idx < deal.momentum.length - 1 && (
                        <div className="w-0.5 h-16 mt-2" style={{ background: COLOR_BORDER }} />
                      )}
                    </div>
                    <div>
                      <p className="font-bold" style={{ color: COLOR_PRIMARY }}>
                        {event.event}
                      </p>
                      <p className="text-sm" style={{ color: COLOR_TEXT_SECONDARY }}>
                        {event.date}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </motion.section>

            {/* Quick Actions */}
            <motion.div variants={itemVariants} className="grid grid-cols-1 md:grid-cols-3 gap-4">
              {[
                { label: 'Request Data Room Access', icon: FileText, color: '#3B82F6' },
                { label: 'Message Deal Team', icon: MessageSquare, color: '#8B5CF6' },
                { label: 'Schedule Management Call', icon: Calendar, color: '#EC4899' },
              ].map((action, idx) => {
                const Icon = action.icon
                return (
                  <motion.button
                    key={idx}
                    className="p-6 rounded-lg border hover:shadow-md transition-all flex items-center gap-3"
                    style={{ borderColor: COLOR_BORDER, background: 'white' }}
                    whileHover={{ y: -2 }}
                  >
                    <div className="p-3 rounded-lg" style={{ background: `${action.color}20` }}>
                      <Icon className="w-5 h-5" style={{ color: action.color }} />
                    </div>
                    <span className="font-semibold text-sm" style={{ color: COLOR_PRIMARY }}>
                      {action.label}
                    </span>
                  </motion.button>
                )
              })}
            </motion.div>
          </motion.div>
        )}

        {/* TAB CONTENT - FINANCIALS */}
        {activeTab === 'financials' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            {/* Financial Summary */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Financial Summary
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                {[
                  { label: 'Revenue (LTM)', value: `$${deal.revenue}M`, detail: `+${deal.revenueGrowth}% YoY` },
                  { label: 'EBITDA (LTM)', value: `$${deal.ebitda}M`, detail: `${deal.ebitdaMargin}% margin` },
                  { label: 'Gross Margin', value: `${deal.grossMargin}%`, detail: 'Strong and stable' },
                  { label: 'Debt/EBITDA', value: `${deal.debtToEbitda}x`, detail: 'Moderate leverage' },
                ].map((item, idx) => (
                  <div key={idx} className="p-4 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                    <p className="text-xs font-semibold mb-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                      {item.label}
                    </p>
                    <p className="text-2xl font-black mb-1" style={{ color: COLOR_PRIMARY }}>
                      {item.value}
                    </p>
                    <p className="text-xs" style={{ color: COLOR_TEXT_SECONDARY }}>
                      {item.detail}
                    </p>
                  </div>
                ))}
              </div>
            </motion.section>

            {/* Valuation Analysis */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Valuation Analysis
              </h2>
              <div className="mb-8">
                <p className="text-sm font-semibold mb-3" style={{ color: COLOR_TEXT_SECONDARY }}>
                  Valuation Range (Weighted Approach)
                </p>
                <div className="relative h-12 bg-gray-100 rounded-lg overflow-hidden mb-4">
                  <div
                    className="absolute h-full flex items-center justify-center text-white font-bold text-sm"
                    style={{
                      background: COLOR_ACCENT,
                      width: '60%',
                      left: '20%',
                    }}
                  >
                    ${weightedValuation}M
                  </div>
                </div>
                <div className="flex justify-between text-xs font-semibold" style={{ color: COLOR_TEXT_SECONDARY }}>
                  <span>${valuationMin}M</span>
                  <span>${weightedValuation}M (Target)</span>
                  <span>${valuationMax}M</span>
                </div>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {[
                  { method: 'DCF Analysis', values: deal.valuation.dcf, weight: '50%' },
                  { method: 'Comparables', values: deal.valuation.comparables, weight: '35%' },
                  { method: 'Precedent', values: deal.valuation.precedent, weight: '15%' },
                ].map((val, idx) => (
                  <div key={idx} className="p-4 rounded-lg border" style={{ borderColor: COLOR_BORDER }}>
                    <p className="text-sm font-bold mb-1" style={{ color: COLOR_PRIMARY }}>
                      {val.method}
                    </p>
                    <p className="text-xs mb-3" style={{ color: COLOR_TEXT_SECONDARY }}>
                      Weight: {val.weight}
                    </p>
                    <div className="space-y-1">
                      <div className="flex justify-between text-xs">
                        <span style={{ color: COLOR_TEXT_SECONDARY }}>Low</span>
                        <span style={{ color: COLOR_PRIMARY }}>${val.values.min}M</span>
                      </div>
                      <div className="flex justify-between text-xs">
                        <span style={{ color: COLOR_TEXT_SECONDARY }}>Mid</span>
                        <span style={{ color: COLOR_ACCENT, fontWeight: 'bold' }}>${val.values.mid}M</span>
                      </div>
                      <div className="flex justify-between text-xs">
                        <span style={{ color: COLOR_TEXT_SECONDARY }}>High</span>
                        <span style={{ color: COLOR_PRIMARY }}>${val.values.max}M</span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </motion.section>

            {/* Valuation Multiples */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Valuation Multiples
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
                {[
                  { label: 'EV / EBITDA', current: deal.priceToEbitda, market: '8.0x - 8.5x', status: 'fair' },
                  { label: 'EV / Revenue', current: deal.priceToRevenue, market: '1.8x - 2.0x', status: 'fair' },
                  { label: 'Price / Sales', current: deal.priceToSales, market: '1.8x - 2.0x', status: 'fair' },
                ].map((mult, idx) => (
                  <div key={idx} className="p-4 rounded-lg border" style={{ borderColor: COLOR_BORDER }}>
                    <p className="text-sm font-bold mb-2" style={{ color: COLOR_PRIMARY }}>
                      {mult.label}
                    </p>
                    <p className="text-2xl font-black mb-1" style={{ color: COLOR_ACCENT }}>
                      {mult.current}x
                    </p>
                    <p className="text-xs mb-2" style={{ color: COLOR_TEXT_SECONDARY }}>
                      Market: {mult.market}
                    </p>
                    <span className="inline-block px-2 py-1 rounded text-xs font-bold" style={{ background: '#10B98120', color: '#059669' }}>
                      ✓ Fair
                    </span>
                  </div>
                ))}
              </div>
            </motion.section>

            {/* Growth Forecast */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                5-Year Growth Forecast
              </h2>
              <div className="space-y-4">
                {deal.forecast.years.map((year: string, idx: number) => (
                  <div key={idx}>
                    <div className="flex justify-between items-center mb-2">
                      <span className="font-semibold" style={{ color: COLOR_PRIMARY }}>
                        {year}
                      </span>
                      <span className="text-sm" style={{ color: COLOR_TEXT_SECONDARY }}>
                        Revenue: ${deal.forecast.revenue[idx]}M • EBITDA: ${deal.forecast.ebitda[idx]}M
                      </span>
                    </div>
                    <div className="h-8 bg-gray-100 rounded-lg overflow-hidden">
                      <div
                        className="h-full"
                        style={{
                          width: `${(deal.forecast.revenue[idx] / deal.forecast.revenue[deal.forecast.revenue.length - 1]) * 100}%`,
                          background: COLOR_ACCENT,
                        }}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </motion.section>
          </motion.div>
        )}

        {/* TAB CONTENT - COMPARABLES */}
        {activeTab === 'comparables' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            {/* Similar Deal Analysis */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border-2" style={{ borderColor: COLOR_ACCENT, background: `${COLOR_ACCENT}08` }}>
              <div className="flex items-center gap-3 mb-6">
                <TrendingUpIcon className="w-6 h-6" style={{ color: COLOR_ACCENT }} />
                <h2 className="text-2xl font-black" style={{ color: COLOR_PRIMARY }}>
                  Similar Deal: {deal.lastDeal.name}
                </h2>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h3 className="font-bold mb-4" style={{ color: COLOR_PRIMARY }}>
                    Deal Comparison
                  </h3>
                  <div className="space-y-3">
                    {[
                      { label: 'Revenue', current: `$${deal.revenue}M`, last: `$${deal.lastDeal.revenue}M` },
                      { label: 'EBITDA', current: `$${deal.ebitda}M`, last: `$${deal.lastDeal.ebitda}M` },
                      { label: 'Revenue Growth', current: `${deal.revenueGrowth}%`, last: `${deal.lastDeal.growth}%` },
                      { label: 'EBITDA Margin', current: `${deal.ebitdaMargin}%`, last: `${deal.lastDeal.margin}%` },
                      { label: 'Purchase Price', current: `$${deal.currentValuation}M`, last: `$${deal.lastDeal.purchasePrice}M` },
                      { label: 'EV/EBITDA', current: `${deal.priceToEbitda}x`, last: `${deal.lastDeal.evEbitda}x` },
                    ].map((comp, idx) => (
                      <div key={idx} className="flex justify-between items-center pb-3 border-b" style={{ borderColor: COLOR_BORDER }}>
                        <span className="text-sm" style={{ color: COLOR_TEXT_SECONDARY }}>
                          {comp.label}
                        </span>
                        <div className="flex gap-4">
                          <span className="font-bold text-right w-24" style={{ color: COLOR_PRIMARY }}>
                            {comp.current}
                          </span>
                          <span className="font-bold text-right w-24" style={{ color: COLOR_TEXT_SECONDARY }}>
                            {comp.last}
                          </span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                <div className="p-6 rounded-lg" style={{ background: 'white', border: `2px solid ${COLOR_BORDER}` }}>
                  <h3 className="font-bold mb-3" style={{ color: COLOR_PRIMARY }}>
                    Key Insights
                  </h3>
                  <p style={{ color: COLOR_TEXT_SECONDARY }}>
                    {deal.lastDeal.differences}
                  </p>
                  <div className="mt-4 p-3 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                    <p className="text-sm font-bold" style={{ color: COLOR_ACCENT }}>
                      Valuation Conclusion
                    </p>
                    <p className="text-xs mt-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                      Acme's {deal.revenueGrowth}% growth combined with {deal.ebitdaMargin}% margins justifies current {deal.priceToEbitda}x multiple. Trading fair.
                    </p>
                  </div>
                </div>
              </div>
            </motion.section>

            {/* Comparables Table */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Comparable Companies
              </h2>
              <div className="overflow-x-auto">
                <table className="w-full">
                  <thead>
                    <tr style={{ borderBottom: `2px solid ${COLOR_BORDER}` }}>
                      <th className="text-left py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>Company</th>
                      <th className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>Revenue</th>
                      <th className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>EBITDA</th>
                      <th className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>EV</th>
                      <th className="text-right py-3 px-4 font-bold" style={{ color: COLOR_ACCENT }}>EV/EBITDA</th>
                    </tr>
                  </thead>
                  <tbody>
                    {deal.comparables.map((comp: any, idx: number) => (
                      <tr key={idx} style={{ borderBottom: `1px solid ${COLOR_BORDER}` }}>
                        <td className="py-3 px-4" style={{ color: COLOR_PRIMARY }}>
                          <div>
                            <p className="font-bold">{comp.name}</p>
                            <p className="text-xs" style={{ color: COLOR_TEXT_SECONDARY }}>{comp.location}</p>
                          </div>
                        </td>
                        <td className="text-right py-3 px-4" style={{ color: COLOR_PRIMARY }}>${comp.revenue}M</td>
                        <td className="text-right py-3 px-4" style={{ color: COLOR_PRIMARY }}>${comp.ebitda}M</td>
                        <td className="text-right py-3 px-4" style={{ color: COLOR_PRIMARY }}>${comp.ev}M</td>
                        <td className="text-right py-3 px-4 font-bold" style={{ color: COLOR_ACCENT }}>{comp.evEbitda}x</td>
                      </tr>
                    ))}
                    <tr style={{ background: `${COLOR_ACCENT}10` }}>
                      <td className="py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>Acme (Target)</td>
                      <td className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>${deal.revenue}M</td>
                      <td className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>${deal.ebitda}M</td>
                      <td className="text-right py-3 px-4 font-bold" style={{ color: COLOR_PRIMARY }}>${deal.currentValuation}M</td>
                      <td className="text-right py-3 px-4 font-bold" style={{ color: COLOR_ACCENT }}>{deal.priceToEbitda}x</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </motion.section>
          </motion.div>
        )}

        {/* TAB CONTENT - MARKET */}
        {activeTab === 'market' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Market Analysis
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="p-6 rounded-lg" style={{ background: `${COLOR_ACCENT}10` }}>
                  <div className="space-y-3">
                    <div className="flex justify-between">
                      <span style={{ color: COLOR_TEXT_SECONDARY }}>Market Size</span>
                      <span className="font-bold" style={{ color: COLOR_PRIMARY }}>${deal.marketSize}M</span>
                    </div>
                    <div className="flex justify-between">
                      <span style={{ color: COLOR_TEXT_SECONDARY }}>Market Share</span>
                      <span className="font-bold" style={{ color: COLOR_ACCENT }}>{deal.marketShare}%</span>
                    </div>
                    <div className="flex justify-between">
                      <span style={{ color: COLOR_TEXT_SECONDARY }}>Growth Rate</span>
                      <span className="font-bold" style={{ color: '#10B981' }}>{deal.marketGrowth}% CAGR</span>
                    </div>
                    <div className="flex justify-between">
                      <span style={{ color: COLOR_TEXT_SECONDARY }}>Competitors</span>
                      <span className="font-bold" style={{ color: COLOR_PRIMARY }}>{deal.competitorCount}</span>
                    </div>
                  </div>
                </div>

                <div className="p-6 rounded-lg border" style={{ borderColor: COLOR_BORDER }}>
                  <p className="text-sm font-semibold mb-3" style={{ color: COLOR_TEXT_SECONDARY }}>Market Position</p>
                  <div className="flex items-center justify-center h-32">
                    <div className="text-center">
                      <Flame className="w-12 h-12 mx-auto mb-2" style={{ color: COLOR_ACCENT }} />
                      <p className="text-2xl font-black" style={{ color: COLOR_ACCENT }}>#{Math.ceil(1 + (100 - deal.marketShare * 10))}</p>
                      <p className="text-xs mt-1" style={{ color: COLOR_TEXT_SECONDARY }}>in market</p>
                    </div>
                  </div>
                </div>
              </div>
            </motion.section>
          </motion.div>
        )}

        {/* TAB CONTENT - RISKS */}
        {activeTab === 'risks' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            <div className="space-y-4">
              {deal.risks.map((risk: any, idx: number) => {
                const severityColor = risk.severity === 'high' ? '#EF4444' : risk.severity === 'medium' ? '#F59E0B' : '#10B981'
                return (
                  <motion.div
                    key={idx}
                    className="p-6 rounded-lg border cursor-pointer"
                    style={{
                      borderColor: COLOR_BORDER,
                      background: expandedRisk === risk.category ? `${severityColor}10` : 'white',
                    }}
                    onClick={() => setExpandedRisk(expandedRisk === risk.category ? null : risk.category)}
                  >
                    <div className="flex items-start justify-between">
                      <div className="flex gap-4 flex-1">
                        <div className="p-2 rounded-lg flex-shrink-0" style={{ background: `${severityColor}20` }}>
                          <AlertCircle className="w-5 h-5" style={{ color: severityColor }} />
                        </div>
                        <div className="flex-1">
                          <h3 className="font-bold" style={{ color: COLOR_PRIMARY }}>
                            {risk.category}: {risk.description}
                          </h3>
                          <p className="text-sm mt-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                            Impact: {risk.impact}
                          </p>
                        </div>
                      </div>
                      <span className="px-3 py-1 rounded-full text-xs font-bold text-white" style={{ background: severityColor }}>
                        {risk.severity.toUpperCase()}
                      </span>
                    </div>
                  </motion.div>
                )
              })}
            </div>

            {/* Risk Score */}
            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h2 className="text-2xl font-black mb-6" style={{ color: COLOR_PRIMARY }}>
                Risk Score: 65% (MODERATE)
              </h2>
              <p style={{ color: COLOR_TEXT_SECONDARY }}>
                Typical manufacturing risks. Market and supply chain exposure are manageable.
              </p>
            </motion.section>
          </motion.div>
        )}

        {/* TAB CONTENT - DILIGENCE */}
        {activeTab === 'diligence' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-4"
          >
            {[
              { category: 'Financial', items: ['3-year audited financials', 'Tax returns', 'Banking relationships', 'Working capital'] },
              { category: 'Legal', items: ['Corporate structure', 'Material contracts', 'Litigation', 'Compliance'] },
              { category: 'Commercial', items: ['Customer analysis', 'Suppliers', 'Pricing', 'Market trends'] },
              { category: 'Operational', items: ['Management team', 'Systems', 'Capacity', 'Supply chain'] },
            ].map((section, idx) => (
              <motion.div key={idx} className="p-6 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
                <h3 className="font-bold text-lg mb-4" style={{ color: COLOR_PRIMARY }}>
                  {section.category} Diligence
                </h3>
                <div className="space-y-2">
                  {section.items.map((item, i) => (
                    <div key={i} className="flex items-center gap-3">
                      <CheckCircle2 className="w-5 h-5" style={{ color: '#10B981' }} />
                      <span style={{ color: COLOR_TEXT_SECONDARY }}>{item}</span>
                    </div>
                  ))}
                </div>
              </motion.div>
            ))}
          </motion.div>
        )}

        {/* TAB CONTENT - DATA ROOM */}
        {activeTab === 'dataroom' && (
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="space-y-8"
          >
            <motion.section variants={itemVariants} className="p-8 rounded-lg border-2" style={{ borderColor: COLOR_ACCENT, background: `${COLOR_ACCENT}08` }}>
              <div className="flex items-center justify-between mb-6">
                <h2 className="text-2xl font-black" style={{ color: COLOR_PRIMARY }}>
                  Data Room
                </h2>
                <motion.button
                  className="px-6 py-3 rounded-lg font-bold text-white"
                  style={{ background: COLOR_ACCENT }}
                  whileHover={{ scale: 1.05 }}
                >
                  Request Access
                </motion.button>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {[
                  { folder: 'Financial Statements', docs: 12 },
                  { folder: 'Tax & Legal', docs: 18 },
                  { folder: 'Customer & Contracts', docs: 24 },
                  { folder: 'Operating Metrics', docs: 8 },
                ].map((folder, idx) => (
                  <div key={idx} className="p-4 rounded-lg border" style={{ borderColor: COLOR_BORDER }}>
                    <p className="font-bold" style={{ color: COLOR_PRIMARY }}>
                      {folder.folder}
                    </p>
                    <p className="text-xs mt-1" style={{ color: COLOR_TEXT_SECONDARY }}>
                      {folder.docs} documents
                    </p>
                  </div>
                ))}
              </div>
            </motion.section>

            <motion.section variants={itemVariants} className="p-8 rounded-lg border" style={{ borderColor: COLOR_BORDER, background: 'white' }}>
              <h3 className="font-bold text-lg mb-4" style={{ color: COLOR_PRIMARY }}>
                Key Documents
              </h3>
              <div className="space-y-3">
                {[
                  { name: 'Confidential Information Memorandum (CIM)', size: '45 MB' },
                  { name: '3-Year Audited Financials', size: '12 MB' },
                  { name: 'Management Presentation', size: '28 MB' },
                  { name: 'Customer List', size: '3 MB' },
                ].map((doc, idx) => (
                  <div key={idx} className="flex items-center justify-between p-4 rounded-lg border" style={{ borderColor: COLOR_BORDER }}>
                    <div className="flex items-center gap-3">
                      <FileText className="w-5 h-5" style={{ color: COLOR_ACCENT }} />
                      <div>
                        <p className="font-semibold text-sm" style={{ color: COLOR_PRIMARY }}>
                          {doc.name}
                        </p>
                        <p className="text-xs" style={{ color: COLOR_TEXT_SECONDARY }}>
                          {doc.size}
                        </p>
                      </div>
                    </div>
                    <Download className="w-5 h-5" style={{ color: COLOR_ACCENT }} />
                  </div>
                ))}
              </div>
            </motion.section>
          </motion.div>
        )}
      </motion.div>
    </>
  )
}
