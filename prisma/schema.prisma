// Forward OS - Production Database Schema
// Complete schema for M&A intelligence and deal management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SELLER
  BUYER
  BROKER
  ADMIN
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
}

enum KYCDocumentType {
  GOVERNMENT_ID
  PASSPORT
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  BANK_STATEMENT
  PROOF_OF_ADDRESS
  BENEFICIAL_OWNER_CERT
  CORPORATE_CERT
}

enum DealStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
  CLOSED
  WITHDRAWN
}

enum IndustryType {
  SAAS
  HEALTHCARE
  RETAIL
  ECOMMERCE
  MANUFACTURING
  FINTECH
  SERVICES
  HOSPITALITY
  EDUCATION
  ENERGY
  REAL_ESTATE
  LOGISTICS
  AUTOMOTIVE
  AGRICULTURE
  BIOTECH
  CPG
  MEDIA
  TELECOM
  OTHER
}

enum DealPipelineStage {
  INTEREST
  QUALIFICATION
  DUE_DILIGENCE
  LOI
  OFFERS
  NEGOTIATION
  FINAL_AGREEMENT
  CLOSING
  CLOSED
}

enum VerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  FAILED
  FLAGGED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MessageType {
  DIRECT_MESSAGE
  DEAL_INQUIRY
  DATA_ROOM_REQUEST
  SYSTEM_NOTIFICATION
  BROKER_COMMUNICATION
}

enum DocumentAccessLevel {
  NONE
  TEASER
  INITIAL_INFO
  FINANCIAL_DATA
  FULL_DATA_ROOM
}

enum TransactionType {
  DEAL_CLOSED
  COMMISSION_EARNED
  COMMISSION_PAID
  REFUND
  BROKER_FEE
}

enum PlanTier {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  ACCOUNT_CREATED
  EMAIL_VERIFIED
  BUSINESS_DATA_SUBMITTED
  PHOTOS_UPLOADED
  PLAN_SELECTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SellerPlanTier {
  FREEMIUM
  PREMIUM
}

enum ListingApprovalStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  APPROVED
  REJECTED
  ACTIVE
}

// ==================== USERS & AUTHENTICATION ====================

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  password              String    @db.Text
  role                  UserRole

  // Profile Information
  company               String?
  phone                 String?
  profileImage          String?
  bio                   String?   @db.Text
  website               String?
  linkedinUrl           String?

  // Buyer specific
  investmentCriteria    String?   @db.Text // JSON: industries, deal sizes, geographies
  investmentAmount      BigInt?   // Total capital available in cents

  // Seller/Broker specific
  yearsInBusiness       Int?
  dealsClosed           Int?      @default(0)
  averageDealSize       BigInt?

  // KYC & Verification
  kycStatus             KYCStatus @default(NOT_STARTED)
  kycVerifiedAt         DateTime?
  kycExpireAt           DateTime?
  kycDocuments          KYCDocument[]
  kycSubmissions        KYCSubmission[]

  // Risk & Verification Moat
  verificationStatus    VerificationStatus @default(NOT_VERIFIED)
  riskScore             Int?      // 0-100, higher = more risk
  riskLevel             RiskLevel @default(MEDIUM)
  riskAssessments       RiskAssessment[]
  fraudFlags            FraudFlag[]

  // Platform engagement
  emailVerified         Boolean   @default(false)
  emailVerifiedAt       DateTime?
  mobileVerified        Boolean   @default(false)
  twoFactorEnabled      Boolean   @default(false)

  // Seller Onboarding (only for SELLER role)
  onboardingStatus      OnboardingStatus? @default(NOT_STARTED)
  sellerPlanTier        SellerPlanTier?
  onboardingCompletedAt DateTime?
  listingApprovalStatus ListingApprovalStatus? @default(DRAFT)
  listingApprovedAt     DateTime?
  approvalNotes         String?   @db.Text

  // Relationships
  dealsAsseller         Deal[]    @relation("SellerDeals")
  savedDeals            SavedDeal[]
  messages              Message[] @relation("MessageAuthor")
  receivedMessages      Message[] @relation("MessageRecipient")
  notifications         Notification[]
  brokerDelegations     BrokerDelegation[] @relation("DelegatingUser")
  delegatedDeals        BrokerDelegation[] @relation("BrokerUser")
  dataRoomAccess        DataRoomAccess[]
  dataRoomsAsOwner      DataRoom[]
  enquiries             Enquiry[]
  seriousnessScores     BuyerSeriousness[]
  heatMapData           DealHeat[]
  progressionHistory    DealProgressionHistory[]
  transactions          Transaction[] @relation("TransactionInitiator")
  brokerTransactions    Transaction[] @relation("BrokerUser")
  emailVerificationTokens EmailVerificationToken[]
  businessPhotos        BusinessPhoto[] @relation("SellerPhotos")

  // BizBuySell-parity features
  savedSearches         SavedSearch[]
  financingInquiries    FinancingInquiry[]
  brokerProfile         BrokerProfile?
  reviewsAuthored       Review[]  @relation("ReviewAuthor")

  // Billing & Subscriptions
  subscription          Subscription? @relation("UserSubscription")

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  lastLoginAt           DateTime?

  @@index([email])
  @@index([role])
  @@index([kycStatus])
  @@index([verificationStatus])
  @@index([riskLevel])
}

// ==================== EMAIL VERIFICATION ====================

model EmailVerificationToken {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  token                 String    @unique
  expiresAt             DateTime

  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ==================== BUSINESS PHOTOS ====================

model BusinessPhoto {
  id                    String    @id @default(cuid())
  seller                User      @relation("SellerPhotos", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId              String

  photoUrl              String    @db.Text // S3 URL
  photoName             String
  photoCaption          String?

  isFeatured            Boolean   @default(false) // One featured photo per seller
  displayOrder          Int       @default(0)

  uploadedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([sellerId])
  @@index([isFeatured])
}

// ==================== KYC & VERIFICATION ====================

model KYCDocument {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  documentType          KYCDocumentType
  documentUrl           String    @db.Text // S3 URL
  documentName          String

  verificationStatus    VerificationStatus @default(PENDING)
  verifiedAt            DateTime?
  rejectionReason       String?   @db.Text

  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([verificationStatus])
}

model KYCSubmission {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  submissionData        String    @db.Text // JSON: answers to KYC questions
  status                KYCStatus @default(PENDING)

  submittedAt           DateTime  @default(now())
  reviewedAt            DateTime?
  reviewNotes           String?   @db.Text

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model RiskAssessment {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  riskLevel             RiskLevel
  riskScore             Int       // 0-100

  factors               String    @db.Text // JSON: array of risk factors
  notes                 String?   @db.Text

  assessedAt            DateTime  @default(now())
  expiresAt             DateTime?

  @@index([userId])
  @@index([riskLevel])
}

model FraudFlag {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  flagType              String    // e.g., "duplicate_email", "suspicious_pattern", "payment_issue"
  severity              RiskLevel
  description           String    @db.Text

  isResolved            Boolean   @default(false)
  resolvedAt            DateTime?
  resolutionNotes       String?   @db.Text

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([severity])
  @@index([isResolved])
}

// ==================== DEALS ====================

model Deal {
  id                    String    @id @default(cuid())

  // Basic Information
  title                 String
  description           String?   @db.Text
  slug                  String?   // For SEO

  // Seller
  seller                User      @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId              String

  // Deal Status
  status                DealStatus @default(DRAFT)
  publishedAt           DateTime?

  // Industry & Geography
  industry              IndustryType
  subIndustry           String?
  country               String
  city                  String?
  stateProvince         String?

  // Financial Information
  revenue               BigInt?   // LTM revenue in cents
  ebitda                BigInt?   // LTM EBITDA in cents
  grossMargin           Float?    // Percentage: 0-100
  ebitdaMargin          Float?    // Percentage: 0-100
  askingPrice           BigInt?   // In cents
  pricingMultiple       Float?    // Price / Revenue or Price / EBITDA

  // Company Details
  employees             Int?
  yearsInOperation      Int?
  foundedYear           Int?

  // Business Characteristics
  reasonForSale         String?
  businessModel         String?   // e.g., "B2B", "B2C", "B2B2C"
  customerConcentration String?   // e.g., "Top 3 customers = 40% revenue"

  // Inclusions
  inventoryIncluded     Boolean   @default(false)
  realEstateIncluded    Boolean   @default(false)
  equipmentIncluded     Boolean   @default(false)
  isFranchise           Boolean   @default(false)

  // Deal Characteristics
  keyStrengths          String?   @db.Text // JSON array
  growthOpportunities   String?   @db.Text // JSON array
  riskFactors           String?   @db.Text // JSON array

  // Engagement Metrics
  views                 Int       @default(0)
  uniqueVisitors        Int       @default(0)
  returningVisitors     Int       @default(0)
  inquiries             Int       @default(0)

  // Intelligence Moat
  heatScore             Int?      // 0-100, proprietary heat map score
  predictedCloseProb    Float?    // 0-100, M&A probability prediction
  dealQualityScore      Int?      // 0-100, deal quality assessment

  // Financing (Finance Center)
  financingEligible     Boolean   @default(false) // qualifies for CSBFP/BDC/SME/Islamic financing
  financingNote         String?   // e.g. "CSBFP eligible up to $1.15M"

  // Relationships
  pipeline              DealPipeline?
  savedBy               SavedDeal[]
  messages              Message[] @relation("DealMessages")
  dataRoom              DataRoom?
  enquiries             Enquiry[]
  seriousnessScores     BuyerSeriousness[]
  heatMap               DealHeat?
  comparables           DealComparable[]
  progressionHistory    DealProgressionHistory[]
  transactions          Transaction[]
  milestones            DealMilestone[]
  documents             DealDocument[]
  financingInquiries    FinancingInquiry[]

  // Dates
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  closedAt              DateTime?

  @@index([sellerId])
  @@index([status])
  @@index([industry])
  @@index([country])
  @@index([heatScore])
  @@index([predictedCloseProb])
  @@index([title])
}

model DealDocument {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  title                 String
  description           String?
  documentUrl           String    @db.Text // S3 URL
  documentType          String    // e.g., "teaser", "executive_summary", "financial_statements"
  fileSize              BigInt

  uploadedAt            DateTime  @default(now())
  expiresAt             DateTime?

  @@index([dealId])
}

// ==================== DEAL PIPELINE & PROGRESSION ====================

model DealPipeline {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String    @unique

  currentStage          DealPipelineStage @default(INTEREST)
  progressPercent       Int       @default(0)

  stageStartedAt        DateTime  @default(now())
  estimatedClosingDate  DateTime?
  actualClosingDate     DateTime?

  daysInCurrentStage    Int       @default(0)
  totalDaysToClose      Int?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([currentStage])
}

model DealProgressionHistory {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  fromStage             DealPipelineStage
  toStage               DealPipelineStage

  changedBy             User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById           String?

  reason                String?   @db.Text
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now())

  @@index([dealId])
  @@index([toStage])
  @@index([changedById])
}

model DealMilestone {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  title                 String
  description           String?   @db.Text

  dueDate               DateTime
  completedAt           DateTime?
  isCompleted           Boolean   @default(false)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([isCompleted])
}

// ==================== INTELLIGENCE MOAT ====================

model DealHeat {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String    @unique
  user                  User?     @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedBy             String?

  // Heat Score Components
  viewsLastWeek         Int       @default(0)
  inquiriesLastWeek     Int       @default(0)
  buyerCompetition      Int       @default(0) // Number of competing buyers
  urgencyLevel          Int       @default(0) // 0-10
  brokerActivity        Int       @default(0) // 0-10

  // Overall Score (0-100)
  heatScore             Int
  trend                 String    @default("stable") // "rising", "stable", "falling"

  // Real-time signals
  recentActivityCount   Int       @default(0)
  lastActivityAt        DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([heatScore])
}

model DealComparable {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  comparableName        String
  comparableIndustry    IndustryType

  // Comparable Metrics
  comparableRevenue     BigInt?
  comparableEbitda      BigInt?
  comparableValuation   BigInt?
  comparableMultiple    Float?    // Valuation / Revenue or EBITDA

  // Comparison
  revenueVsTarget       Float?    // Percentage difference
  ebitdaVsTarget        Float?
  multipleVsTarget      Float?

  source                String?   // e.g., "public_company", "recent_transaction", "market_data"
  notes                 String?   @db.Text

  createdAt             DateTime  @default(now())

  @@index([dealId])
}

model BuyerSeriousness {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String
  buyer                 User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId               String

  seriousnessScore      Int       // 0-100
  confidenceLevel       Int       // 0-100, confidence in the score

  signals               String    @db.Text // JSON: engagement signals, document requests, etc.
  lastEngagementAt      DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([dealId, buyerId])
  @@index([dealId])
  @@index([buyerId])
  @@index([seriousnessScore])
}

// ==================== SAVED DEALS & WATCHLISTS ====================

model SavedDeal {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  savedAt               DateTime  @default(now())
  notes                 String?   @db.Text

  @@unique([userId, dealId])
  @@index([userId])
  @@index([dealId])
}

// ==================== DATA ROOMS ====================

model DataRoom {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String    @unique
  seller                User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId              String

  title                 String
  description           String?   @db.Text

  accessLevel           DocumentAccessLevel @default(INITIAL_INFO)
  ndaRequired           Boolean   @default(true)
  passwordProtected     Boolean   @default(false)

  documentsCount        Int       @default(0)
  accessRequests        DataRoomAccess[]
  ndaSignatures         NDASignature[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([sellerId])
}

model DataRoomAccess {
  id                    String    @id @default(cuid())
  dataRoom              DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  dataRoomId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  accessLevel           DocumentAccessLevel
  approvedAt            DateTime?
  expiresAt             DateTime?

  ndaSigned             Boolean   @default(false)
  ndaSignedAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([dataRoomId, userId])
  @@index([dataRoomId])
  @@index([userId])
}

model NDASignature {
  id                    String    @id @default(cuid())
  dataRoom              DataRoom  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  dataRoomId            String

  signerName            String
  signerEmail           String
  signerCompany         String?

  signatureUrl          String    @db.Text // S3 URL to signed NDA
  ipAddress             String?

  signedAt              DateTime
  createdAt             DateTime  @default(now())

  @@index([dataRoomId])
}

// ==================== MESSAGING ====================

model Message {
  id                    String    @id @default(cuid())

  author                User      @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId              String
  recipient             User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId           String

  deal                  Deal?     @relation("DealMessages", fields: [dealId], references: [id], onDelete: SetNull)
  dealId                String?

  messageType           MessageType @default(DIRECT_MESSAGE)
  subject               String?
  content               String    @db.Text

  isRead                Boolean   @default(false)
  readAt                DateTime?
  isArchived            Boolean   @default(false)

  attachments           String?   @db.Text // JSON: array of URLs

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([authorId])
  @@index([recipientId])
  @@index([dealId])
  @@index([isRead])
}

model Notification {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  title                 String
  message               String    @db.Text
  notificationType      String    // e.g., "deal_inquiry", "message", "update"

  isRead                Boolean   @default(false)
  readAt                DateTime?

  actionUrl             String?

  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

// ==================== BROKER & DELEGATION ====================

model BrokerDelegation {
  id                    String    @id @default(cuid())
  delegatingUser        User      @relation("DelegatingUser", fields: [delegatingUserId], references: [id], onDelete: Cascade)
  delegatingUserId      String

  broker                User      @relation("BrokerUser", fields: [brokerId], references: [id], onDelete: Cascade)
  brokerId              String

  dealIds               String    @db.Text // JSON: array of deal IDs
  commissionPercent     Float     // 0-100

  isActive              Boolean   @default(true)
  startDate             DateTime  @default(now())
  endDate               DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([delegatingUserId, brokerId])
  @@index([delegatingUserId])
  @@index([brokerId])
}

// ==================== ENQUIRIES & ENGAGEMENT ====================

model Enquiry {
  id                    String    @id @default(cuid())
  deal                  Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId                String

  inquirer              User      @relation(fields: [inquirerId], references: [id], onDelete: Cascade)
  inquirerId            String

  inquiryType           String    // e.g., "general", "data_room_access", "meeting_request"
  message               String    @db.Text

  status                String    @default("pending") // "pending", "responded", "closed"
  respondedAt           DateTime?
  response              String?   @db.Text

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([inquirerId])
  @@index([status])
}

// ==================== TRANSACTIONS & COMMISSION ====================

model Transaction {
  id                    String    @id @default(cuid())

  deal                  Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId                String?

  initiator             User?     @relation("TransactionInitiator", fields: [initiatorId], references: [id], onDelete: SetNull)
  initiatorId           String?

  broker                User?     @relation("BrokerUser", fields: [brokerId], references: [id], onDelete: SetNull)
  brokerId              String?

  transactionType       TransactionType

  amount                BigInt    // In cents
  currency              String    @default("AED")

  description           String?   @db.Text
  referenceId           String?   // External reference

  status                String    @default("pending") // "pending", "completed", "failed"
  completedAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([dealId])
  @@index([initiatorId])
  @@index([brokerId])
  @@index([status])
}

// ==================== BILLING & SUBSCRIPTIONS ====================

model Subscription {
  id                    String    @id @default(cuid())
  user                  User      @relation("UserSubscription", fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @unique

  planTier              PlanTier  @default(STARTER)
  status                SubscriptionStatus @default(TRIALING)

  // Billing Cycle
  startDate             DateTime  @default(now())
  endDate               DateTime? // Next billing date or expiration date
  trialEndsAt           DateTime? // 14-day free trial

  // Cancellation
  cancelledAt           DateTime?
  cancellationReason    String?
  expiresAt             DateTime? // Date when access ends (next day after endDate if cancelled)

  // Payment & Stripe
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?

  // Pricing
  billingCurrency       String    @default("USD")
  monthlyPrice          Int       // In cents
  annualPrice           Int?      // In cents, if billed annually

  // Preferences
  billingCycle          String    @default("monthly") // "monthly" or "annual"
  autoRenew             Boolean   @default(true)

  // Usage Tracking
  apiCallsUsed          Int       @default(0)
  apiCallsLimit         Int       @default(0) // 0 = unlimited

  // Relationships
  events                SubscriptionEvent[]
  invoices              Invoice[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planTier])
  @@index([expiresAt])
}

model SubscriptionEvent {
  id                    String    @id @default(cuid())
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId        String

  eventType             String    // "upgrade", "downgrade", "renewal", "cancellation", "expiration"
  previousPlan          PlanTier?
  newPlan               PlanTier?

  amount                Int?      // In cents
  stripeEventId         String?

  description           String?   @db.Text

  createdAt             DateTime  @default(now())

  @@index([subscriptionId])
  @@index([eventType])
}

model Invoice {
  id                    String    @id @default(cuid())
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId        String

  invoiceNumber         String    @unique
  stripeInvoiceId       String?

  amount                Int       // In cents
  currency              String    @default("USD")
  status                String    @default("draft") // "draft", "sent", "paid", "failed"

  billingPeriodStart    DateTime
  billingPeriodEnd      DateTime
  dueDate               DateTime
  paidAt                DateTime?

  description           String?   @db.Text

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
}

// ==================== AUDIT & COMPLIANCE ====================

model AuditLog {
  id                    String    @id @default(cuid())

  userId                String?
  action                String
  resourceType          String    // e.g., "deal", "user", "data_room"
  resourceId            String?

  changes               String?   @db.Text // JSON: before/after
  ipAddress             String?
  userAgent             String?

  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

// ==================== SYSTEM & CONFIGURATION ====================

model SystemConfig {
  id                    String    @id @default(cuid())

  key                   String    @unique
  value                 String    @db.Text // JSON if needed

  updatedAt             DateTime  @updatedAt
}

// ==================== BIZBUYSELL-PARITY: ENUMS ====================

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum FinancingType {
  SBA                // US (parity reference)
  CSBFP              // Canada Small Business Financing Program
  BDC                // Business Development Bank of Canada
  BANK_TERM          // Conventional bank term loan
  SME_LOAN           // UAE SME lending
  ISLAMIC_MURABAHA   // Sharia-compliant cost-plus financing
  ISLAMIC_IJARA      // Sharia-compliant lease-to-own
  SELLER_FINANCING   // Vendor take-back / earnout
}

enum LenderRegion {
  USA
  CANADA
  UAE
  GLOBAL
}

enum FinancierStatus {
  PENDING        // applied, awaiting admin review
  APPROVED       // admin approved; referral agreement sent for signature
  SIGNED         // agreement digitally signed
  ACTIVE         // fully onboarded and marketed
  REJECTED
}

enum FeedbackKind {
  FEATURE
  BUG
  PRAISE
  OTHER
}

// Demonstrable consent (GDPR Art. 7) — a server-side record each time a visitor
// sets/updates their cookie & tracking preferences.
model ConsentLog {
  id        String   @id @default(cuid())
  anonId    String?
  userId    String?
  analytics Boolean
  marketing Boolean
  version   Int
  source    String?  // e.g. "banner", "settings"
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([anonId])
  @@index([userId])
  @@index([createdAt])
}

// User feedback — feature requests, bugs, praise. Works logged-in or anonymous;
// userId is attached server-side from the session when present (no FK, so
// anonymous submissions are unconstrained).
model Feedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind @default(OTHER)
  message   String       @db.Text
  page      String?
  locale    String?
  userId    String?
  anonId    String?
  userAgent String?
  createdAt DateTime     @default(now())

  @@index([kind])
  @@index([createdAt])
}

// ==================== SAVED SEARCHES & EMAIL ALERTS ====================

model SavedSearch {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  name                  String
  filters               String    @db.Text // JSON: industries, country, price/revenue ranges, etc.
  country               String?

  alertEnabled          Boolean   @default(true)
  alertFrequency        AlertFrequency @default(DAILY)
  lastAlertedAt         DateTime?

  deliveries            AlertDelivery[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([alertEnabled])
}

model AlertDelivery {
  id                    String    @id @default(cuid())
  savedSearch           SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)
  savedSearchId         String

  dealIds               String    @db.Text // JSON array of deal IDs included in this alert
  matchCount            Int       @default(0)
  sentAt                DateTime  @default(now())

  @@index([savedSearchId])
}

// ==================== FINANCE CENTER (UAE + CANADA) ====================

model Lender {
  id                    String    @id @default(cuid())

  name                  String
  region                LenderRegion
  financingTypes        String    @db.Text // JSON array of FinancingType
  description           String    @db.Text
  logoUrl               String?
  applyUrl              String?

  minAmount             BigInt    // cents (USD base)
  maxAmount             BigInt    // cents (USD base)
  interestRateMin       Float     // annual %, nominal (0 for profit-rate Islamic products)
  interestRateMax       Float
  termMonthsMin         Int
  termMonthsMax         Int
  maxLtvPercent         Int       @default(80) // max loan-to-value
  shariaCompliant       Boolean   @default(false)

  isActive              Boolean   @default(true) // marketed in the directory when true
  inquiries             FinancingInquiry[]

  // ---- Financier partner application & onboarding ----
  status                FinancierStatus @default(ACTIVE) // seeded lenders ACTIVE; new applications start PENDING
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  referralFeePercent    Float?    // proposed referral fee %
  referralPlan          String?   @db.Text // their proposed referral plan / terms
  adminNotes            String?   @db.Text

  // Referral agreement (digital signature) with UpCapital Global FZCO
  agreementVersion      String?
  agreementSignerName   String?
  agreementSignerTitle  String?
  agreementSignatureUrl String?   @db.Text // base64 data-URL of the captured signature
  agreementSignedAt     DateTime?
  agreementIp           String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([region])
  @@index([isActive])
  @@index([status])
}

model FinancingInquiry {
  id                    String    @id @default(cuid())
  user                  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                String?
  deal                  Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId                String?
  lender                Lender?   @relation(fields: [lenderId], references: [id], onDelete: SetNull)
  lenderId              String?

  requestedAmount       BigInt    // cents (USD base)
  currency              String    @default("USD")
  downPaymentPct        Float
  termMonths            Int?
  region                LenderRegion

  contactName           String?
  contactEmail          String?
  message               String?   @db.Text
  status                String    @default("pending") // pending / contacted / closed

  createdAt             DateTime  @default(now())

  @@index([userId])
  @@index([dealId])
  @@index([lenderId])
}

// ==================== BROKER DIRECTORY & REVIEWS ====================

model BrokerProfile {
  id                    String    @id @default(cuid())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String    @unique

  headline              String
  bio                   String    @db.Text
  specialties           String    @db.Text // JSON array
  industries            String    @db.Text // JSON array of IndustryType
  regions               String    @db.Text // JSON array (e.g. ["CANADA","UAE"])
  languages             String    @db.Text // JSON array (e.g. ["EN","FR","AR"])

  yearsExperience       Int       @default(0)
  dealsClosed           Int       @default(0)
  totalValueClosed      BigInt    @default(0) // cents (USD base)

  isVerified            Boolean   @default(false)
  isFeatured            Boolean   @default(false)
  avgRating             Float     @default(0)
  reviewCount           Int       @default(0)

  reviews               Review[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([isVerified])
}

model Review {
  id                    String    @id @default(cuid())
  author                User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId              String
  brokerProfile         BrokerProfile @relation(fields: [brokerProfileId], references: [id], onDelete: Cascade)
  brokerProfileId       String
  dealId                String?

  rating                Int       // 1-5
  title                 String
  comment               String    @db.Text
  communicationScore    Int?      // 1-5
  transparencyScore     Int?      // 1-5
  outcomeScore          Int?      // 1-5
  isVerifiedDeal        Boolean   @default(false)

  createdAt             DateTime  @default(now())

  @@index([brokerProfileId])
  @@index([authorId])
}

// ==================== MARKET INSIGHTS ====================

model MarketInsightSnapshot {
  id                    String    @id @default(cuid())

  region                LenderRegion
  period                String    // e.g. "2026-Q2"
  industry              IndustryType?

  medianAskingPrice     BigInt    // cents (USD base)
  medianRevenue         BigInt    // cents (USD base)
  medianMultiple        Float
  salesToAskRatio       Float     // 0-1
  activeListings        Int
  avgDaysOnMarket       Int
  metrics               String    @db.Text // JSON: sector breakdown, trend deltas

  createdAt             DateTime  @default(now())

  @@index([region, period])
}
