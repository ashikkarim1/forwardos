// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SELLER
  BUYER
  BROKER
}

enum KYCStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DealStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  WITHDRAWN
}

enum IndustryType {
  SAAS
  HEALTHCARE
  RETAIL
  ECOMMERCE
  MANUFACTURING
  FINTECH
  SERVICES
  HOSPITALITY
  EDUCATION
  OTHER
}

enum DealPipelineStage {
  INTEREST
  QUALIFICATION
  DUE_DILIGENCE
  LOI
  OFFERS
  NEGOTIATION
  FINAL_AGREEMENT
  CLOSING
  CLOSED
}

// ==================== USERS & AUTHENTICATION ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          UserRole
  company       String?
  phone         String?

  // KYC
  kycStatus     KYCStatus @default(NOT_STARTED)
  kycVerifiedAt DateTime?
  kycExpireAt   DateTime?

  // Relationships
  deals         Deal[]    @relation("SellerDeals")
  savedDeals    SavedDeal[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

// ==================== DEALS ====================

model Deal {
  id                String    @id @default(cuid())
  title             String
  description       String?   @db.Text

  // Seller info
  seller            User      @relation("SellerDeals", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId          String

  // Basic info
  status            DealStatus @default(PUBLISHED)
  industry          IndustryType

  // Location
  country           String
  city              String?

  // Financial metrics
  revenue           BigInt?   // In cents (e.g., 1000000 = $10,000)
  ebitda            BigInt?
  askingPrice       BigInt?
  employees         Int?
  yearsInOperation  Int?

  // Deal characteristics
  reasonForSale     String?
  inventoryIncluded Boolean   @default(false)
  realEstateIncluded Boolean  @default(false)
  isFranchise       Boolean   @default(false)

  // Engagement metrics
  views             Int       @default(0)
  uniqueVisitors    Int       @default(0)
  returningVisitors Int       @default(0)
  inquiries         Int       @default(0)

  // Dates
  publishedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  pipeline          DealPipeline?
  saved             SavedDeal[]

  @@index([sellerId])
  @@index([status])
  @@index([industry])
  @@index([country])
}

// ==================== DEAL PIPELINE ====================

model DealPipeline {
  id                  String    @id @default(cuid())
  deal                Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId              String    @unique

  currentStage        DealPipelineStage @default(INTEREST)
  progressPercent     Int       @default(0)

  stageStartedAt      DateTime  @default(now())
  estimatedClosingDate DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([dealId])
  @@index([currentStage])
}

// ==================== SAVED DEALS ====================

model SavedDeal {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String

  savedAt   DateTime @default(now())

  @@unique([userId, dealId])
  @@index([userId])
  @@index([dealId])
}
