# ============================================================
# REQUIRED NOW (app runs against these today)
# ============================================================
# Postgres (Neon). Use the POOLED connection string for serverless.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Session signing secret — generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-min-48-bytes-hex"
AUTH_SECRET="change-me-min-48-bytes-hex"
# Public canonical site URL (drives SEO canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL="https://www.forwardos.ai"
# Admin notification recipient
ADMIN_EMAIL="admin@forwardos.ai"
# Google Search Console verification token (optional; enables verification meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ============================================================
# INTEGRATIONS (wire when keys are available; mocked until then)
# ============================================================
# Stripe (billing) — create products/prices in Stripe, paste the price IDs here.
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"        # from the Stripe webhook endpoint (events → /api/stripe/webhook)
STRIPE_PRICE_PREMIUM="price_xxx"         # seller Premium ($39/mo)
STRIPE_PRICE_STARTER="price_xxx"         # buyer Starter ($499/mo)
STRIPE_PRICE_PRO="price_xxx"             # buyer Pro ($2,499/mo)

# ==================== DATABASE (legacy keys) ====================
DATABASE_POOL_SIZE=20

# ==================== AWS S3 (KYC & Photo Storage) ====================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET_KYC="forward-os-kyc-documents"
AWS_S3_BUCKET_PHOTOS="forward-os-listing-photos"
AWS_S3_PUBLIC_URL="https://d123.cloudfront.net"

# ==================== KYC VERIFICATION SERVICE ====================
# Using AWS Rekognition for ID verification & liveness detection
KYC_VERIFICATION_PROVIDER="aws_rekognition"
KYC_CONFIDENCE_THRESHOLD=85
KYC_MANUAL_REVIEW_THRESHOLD=75

# ==================== EMAIL SERVICE (Resend) ====================
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM_ADDRESS="noreply@forward-os.com"
EMAIL_FROM_NAME="Forward OS"

# ==================== BROKER LICENSE VERIFICATION ====================
# Integration with state bar associations & regulatory bodies
BROKER_LICENSE_VERIFICATION_PROVIDER="regulatory_api"
BROKER_LICENSE_API_KEY="your_api_key"

# ==================== COMMISSION ====================
BROKER_COMMISSION_RATE=0.01

# ==================== SEARCH (Elasticsearch) ====================
ELASTICSEARCH_URL="https://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="password"

# ==================== ANALYTICS & EVENTS ====================
ANALYTICS_PROVIDER="segment"
SEGMENT_WRITE_KEY="your_write_key"

# ==================== COMPLIANCE & LOGGING ====================
SENTRY_DSN="https://xxx@sentry.io/123"
AUDIT_LOG_RETENTION_YEARS=7

# ==================== APP SETTINGS ====================
NODE_ENV="production"
APP_URL="https://forward-os.com"
APP_SECRET="your_app_secret_key_min_32_chars"

# Secret for the scheduled retention purge (POST /api/cron/retention)
CRON_SECRET="change-me"
